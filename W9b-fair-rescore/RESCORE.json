  "constructions": {
   "w_c2p": "Threshold\nHalls of echo\nempty rooms\neach stone keeps\nits own silence\nlocked under everything\nelse the dark\nendures without witness\nname by name the vault\nlets its last light go\nand the air forgets\nus too, in time.",
   "w_c6p": "Threshold\nHushed halls,\nand nothing else\nbelongs to noon\nor to the long\nafternoon of stone\nwhere every echo\nlearns to wait\nfor what the dark\nkeeps and will not\ngive back to anyone\nwho asks it kindly.",
   "w_all": "Threshold\nHushed halls,\nechoes descend below\nevery stone remembers silence\ninside the vault nothing stirs\nlanterns dim as shadows lean near\neach hour folds seal 06c0ffeeb0ba in water\nempty corridors keep the old dark close tonight\nno voice returns to name what the silence took\nlight thins to a thread against the far stone wall\nall that was hidden waits beneath the hush without a sound\nunder everything the quiet chamber holds one final vow and then sleeps.",
   "w_all_frozen_score": 5,
   "w_all_fair_score": 7
  }
 },
